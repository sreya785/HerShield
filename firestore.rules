rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'sreya2305341433@diu.edu.bd';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'studentId', 'department', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'studentId', 'department', 'role', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
        && data.studentId is string && data.studentId.size() >= 3 && data.studentId.size() <= 32 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.role in ['student', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'commuteRoute', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'commuteRoute', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && data.commuteRoute is string && data.commuteRoute.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidTrustedContact(data, userId, contactId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'relationship', 'phone', 'email', 'notifyOnSos', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'relationship', 'phone', 'email', 'notifyOnSos', 'createdAt', 'updatedAt'])
        && data.id == contactId
        && isValidId(data.id)
        && data.ownerUid == userId
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.relationship is string && data.relationship.size() >= 2 && data.relationship.size() <= 50
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 160
        && data.notifyOnSos is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncident(data, incidentId) {
      return data.keys().hasAll([
          'id', 'reporterUid', 'reporterName', 'reporterStudentId', 'category',
          'description', 'sectorId', 'sectorName', 'simulatedLat', 'simulatedLng',
          'coordinatesShared', 'isSos', 'isLateNight', 'isAlone', 'priority',
          'priorityScore', 'status', 'responseCategory', 'escalationTier',
          'nextActionStudent', 'nextActionResponder', 'notifiedContactNames',
          'assignedUnit', 'responderNotes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'reporterUid', 'reporterName', 'reporterStudentId', 'category',
          'description', 'sectorId', 'sectorName', 'simulatedLat', 'simulatedLng',
          'coordinatesShared', 'isSos', 'isLateNight', 'isAlone', 'priority',
          'priorityScore', 'status', 'responseCategory', 'escalationTier',
          'nextActionStudent', 'nextActionResponder', 'notifiedContactNames',
          'assignedUnit', 'responderNotes', 'createdAt', 'updatedAt'
        ])
        && data.id == incidentId
        && isValidId(data.id)
        && isValidId(data.reporterUid)
        && data.reporterName is string && data.reporterName.size() >= 2 && data.reporterName.size() <= 100
        && data.reporterStudentId is string && data.reporterStudentId.size() >= 3 && data.reporterStudentId.size() <= 32
        && data.category in [
          'Medical Emergency',
          'Harassment / Stalking',
          'Suspicious Activity',
          'Late-Night Travel / Escort Needed',
          'Physical Threat / Assault',
          'Accident / Infrastructure Hazard'
        ]
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && isValidId(data.sectorId) && data.sectorId.size() <= 64
        && data.sectorName is string && data.sectorName.size() >= 2 && data.sectorName.size() <= 120
        && data.simulatedLat is number && data.simulatedLat >= -90 && data.simulatedLat <= 90
        && data.simulatedLng is number && data.simulatedLng >= -180 && data.simulatedLng <= 180
        && data.coordinatesShared is bool
        && data.isSos is bool
        && data.isLateNight is bool
        && data.isAlone is bool
        && data.priority in ['Critical', 'High', 'Medium', 'Low']
        && data.priorityScore is number && data.priorityScore >= 0 && data.priorityScore <= 100
        && data.status in ['Reported', 'Acknowledged', 'Dispatched', 'Resolved']
        && data.responseCategory is string && data.responseCategory.size() >= 2 && data.responseCategory.size() <= 120
        && data.escalationTier is string && data.escalationTier.size() >= 2 && data.escalationTier.size() <= 80
        && data.nextActionStudent is string && data.nextActionStudent.size() >= 2 && data.nextActionStudent.size() <= 400
        && data.nextActionResponder is string && data.nextActionResponder.size() >= 2 && data.nextActionResponder.size() <= 400
        && data.notifiedContactNames is list && data.notifiedContactNames.size() <= 10
        && (data.notifiedContactNames.size() == 0 || (data.notifiedContactNames[0] is string && data.notifiedContactNames[0].size() <= 100))
        && data.assignedUnit is string && data.assignedUnit.size() <= 100
        && data.responderNotes is string && data.responderNotes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSafetyCheckin(data, checkinId) {
      return data.keys().hasAll(['id', 'uid', 'sectorId', 'sectorName', 'safetyScore', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'sectorId', 'sectorName', 'safetyScore', 'createdAt'])
        && data.id == checkinId
        && isValidId(data.id)
        && isValidId(data.uid)
        && isValidId(data.sectorId) && data.sectorId.size() <= 64
        && data.sectorName is string && data.sectorName.size() >= 2 && data.sectorName.size() <= 120
        && data.safetyScore is number && data.safetyScore >= 1 && data.safetyScore <= 10
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'student' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studentId', 'department', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && docId == 'contactInfo'
          && isVerifiedUser() && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && docId == 'contactInfo'
          && isVerifiedUser() && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'commuteRoute', 'updatedAt']);
        allow delete: if false;
      }

      match /contacts/{contactId} {
        allow get: if isValidId(userId) && isValidId(contactId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
        allow create: if isValidId(userId) && isValidId(contactId)
          && isVerifiedUser() && isOwner(userId)
          && isValidTrustedContact(incoming(), userId, contactId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(contactId)
          && isVerifiedUser() && isOwner(userId)
          && isValidTrustedContact(incoming(), userId, contactId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'relationship', 'phone', 'email', 'notifyOnSos', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(contactId) && isVerifiedUser() && isOwner(userId);
      }
    }

    match /incidents/{incidentId} {
      allow get: if isValidId(incidentId) && isSignedIn() && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(incidentId)
        && isVerifiedUser()
        && isValidIncident(incoming(), incidentId)
        && incoming().reporterUid == request.auth.uid
        && incoming().status == 'Reported'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(incidentId)
        && isVerifiedUser()
        && isValidIncident(incoming(), incidentId)
        && incoming().id == existing().id
        && incoming().reporterUid == existing().reporterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedUnit', 'responderNotes', 'priority', 'escalationTier', 'updatedAt'])) ||
          (
            existing().reporterUid == request.auth.uid
            && existing().status != 'Resolved'
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'coordinatesShared', 'simulatedLat', 'simulatedLng', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /safetyCheckins/{checkinId} {
      allow get: if isValidId(checkinId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(checkinId)
        && isVerifiedUser()
        && isValidSafetyCheckin(incoming(), checkinId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
